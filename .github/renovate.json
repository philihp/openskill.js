{
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "every weekend"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Independency Dashboard",
  "semanticCommits": "enabled",
  "transitiveRemediation": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}
